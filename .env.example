# Demo-only defaults. Change every value outside an isolated local workstation.
MINIO_ROOT_USER=demo_minio_admin
MINIO_ROOT_PASSWORD=change-me-minio-admin
DOCTOR_S3_ACCESS_KEY=doctor_reader
DOCTOR_S3_SECRET_KEY=change-me-doctor-s3
POSTGRES_ADMIN_PASSWORD=change-me-postgres-admin
DOCTOR_POSTGRES_PASSWORD=change-me-doctor-postgres

DOCTOR_S3_ENDPOINT=http://minio:9000
DOCTOR_S3_REGION=us-east-1
DOCTOR_S3_BUCKET=datarepo-demo
DOCTOR_POSTGRES_DSN=postgresql://doctor_reader:change-me-doctor-postgres@postgres:5432/datarepo_demo
DOCTOR_ROAPI_URL=http://roapi:8080
DOCTOR_DATABASE_URL=sqlite:////data/datarepo-doctor.db
DOCTOR_SCHEDULES_ENABLED=true

